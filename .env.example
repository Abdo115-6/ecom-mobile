# --- WhatsApp automatic order confirmation ---
# Provider: "baileys" (your own WhatsApp via QR code, no Meta), "cloud" (official Meta API) or "gateway" (any HTTP bot)
WHATSAPP_PROVIDER=baileys
# baileys only: secret needed to open /api/whatsapp/qr?key=...  (mandatory in production)
WHATSAPP_QR_KEY=
# baileys only: where the login session is stored (keep it on a persistent disk)
WHATSAPP_SESSION_DIR=./data/wa-session
WHATSAPP_PHONE_NUMBER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# Approved template name (needed to message customers first). Body params: {{1}} name, {{2}} order no., {{3}} total, {{4}} city
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=fr
# Variables sent to the template, in order ({{1}},{{2}},...). Available: customer_name, order_number, total, city, address, items, date, tracking_number
WHATSAPP_TEMPLATE_PARAMS=customer_name,order_number,total,city
# Webhook (customer replies OUI / NON)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Only for provider=gateway
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_TOKEN=
